# CN fork: 本地开发配置。
# WCL API 走同源 /wcl-api/（vite proxy → 本地 wcl-proxy-server localhost:9528），
# 需要先启动 9528 服务，见 README 的 CN fork 说明。
# 没有配置 WCL API 时 makeWclApiUrl 会直接抛错，不会回退到 wowanalyzer.com。
VITE_SERVER_BASE=/
VITE_WCL_DIRECT=true
VITE_DISABLE_USER_FETCH=true
VITE_DISABLE_SOCIAL_FEATURES=true
VITE_FORCE_PREMIUM=true
VITE_ENABLE_GA=false

# Sentry is usually only enabled in production
VITE_ENVIRONMENT_NAME=dev
VITE_VERSION=dev
# Sentry DSN intentionally disabled for this fork.
# VITE_SENTRY_DSN=https://95bf5a7af57f4a57af1f1be4d0706a91@sentry.io/232829
