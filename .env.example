# CN fork: 生产环境默认直连 CN WCL API，不需要 1Panel/nginx 配 /wcl-api
VITE_WCL_API_BASE=https://wcl-live-mp.rpglogs.cn
VITE_WCL_DIRECT=false
VITE_DISABLE_USER_FETCH=true

# 本地开发如果使用 localhost:9528 的 wcl-proxy-server：
# VITE_WCL_API_BASE=
# VITE_WCL_DIRECT=true
# VITE_DISABLE_USER_FETCH=false

# Docker nginx fallback proxies, only used when a request stays on the current host.
WCL_API_PROXY_TARGET=https://wcl-live-mp.rpglogs.cn/v1/
WCL_API_PROXY_HOST=wcl-live-mp.rpglogs.cn
WOWANALYZER_API_PROXY_TARGET=https://wowanalyzer.com/i/
WOWANALYZER_API_PROXY_HOST=wowanalyzer.com

# Docker build package registry. 国内服务器建议保留 npmmirror，海外服务器可改回 https://registry.npmjs.org
PNPM_VERSION=9.5.0
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# （可选）直连 CN WCL API 时使用的 v1 API key
# 仅当 wcl-proxy-server 不可用时使用，需要配合 Vite proxy 的 api_key 注入逻辑
# VITE_WCL_API_KEY=your_v1_api_key_here
