# CN fork: 生产环境默认直连 CN WCL API，不需要 1Panel/nginx 配 /wcl-api
VITE_WCL_API_BASE=https://wcl-live-mp.rpglogs.cn
VITE_WCL_DIRECT=false
VITE_DISABLE_USER_FETCH=true
# CN fork: 关闭依赖 wowanalyzer.com 后端的功能（角色/公会搜索预检、公会报告页、
# 非国服角色资料、spell 信息查询、server metrics），相关 UI 入口一并隐藏。
# 必须保持 true：本仓库没有任何部署形态会向 wowanalyzer.com 发请求。
VITE_DISABLE_SOCIAL_FEATURES=true

# CN 角色资料 armory 网关(国服英雄榜)。CN 报告的角色信息(query 到 thumbnail/race)
# 由前端请求同源相对路径 /cn-armory/... 转发到该网关(vite dev proxy / 生产 nginx 代理)。
# 网关 CORS 不允许 auth 头,必须同源代理,不能用绝对跨域地址(会触发 preflight)。
# 默认值即为建议值;只有网关地址变更时才需要改。
VITE_CN_ARMORY_BASE=/cn-armory/wow-armory-server/api

# 本地开发如果使用 localhost:9528 的 wcl-proxy-server：
# VITE_WCL_API_BASE=
# VITE_WCL_DIRECT=true
# VITE_DISABLE_USER_FETCH=false

# Docker nginx fallback proxies, only used when a request stays on the current host.
WCL_API_PROXY_TARGET=https://wcl-live-mp.rpglogs.cn/v1/
WCL_API_PROXY_HOST=wcl-live-mp.rpglogs.cn

# Docker build package registry. 国内服务器建议保留 npmmirror，海外服务器可改回 https://registry.npmjs.org
PNPM_VERSION=9.5.0
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# （可选）直连 CN WCL API 时使用的 v1 API key
# 仅当 wcl-proxy-server 不可用时使用，需要配合 Vite proxy 的 api_key 注入逻辑
# VITE_WCL_API_KEY=your_v1_api_key_here

# Dungeon Learning Companion（仅本地开发；复制到 .env.local 后启用）
# 本地开发直接复用与生产/preview 相同的 OSS 瓦片/封面（已提交
# src/dungeon/data/assets/oss.manifest.json，OSS 从 localhost 可达）。
# 用下面命令从本地镜像校验生成，把打印的两行（provider 行 + manifest 行）都粘贴到 .env.local：
#   pnpm dungeon:print-dev-manifest
# VITE_DUNGEON_ASSET_PROVIDER=remote-dev
# VITE_DUNGEON_DEV_ASSET_MANIFEST={"provider":"remote-dev","assets":{"midnight-s2:altar-of-fangs":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/fang/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:altar-of-fangs:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/midnight/altar_of_fangs.jpg"},"midnight-s2:den-of-nalorakk":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/nalo/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:den-of-nalorakk:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/midnight/den_of_nalorakk.jpg"},"midnight-s2:kings-rest":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/kr/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:kings-rest:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/bfa/kingsrest.jpg"},"midnight-s2:murder-row":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/murd/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:murder-row:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/midnight/murder_row.jpg"},"midnight-s2:ruby-life-pools":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/rlp/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:ruby-life-pools:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/df/rubylifepools.jpg"},"midnight-s2:temple-of-sethraliss":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/tos/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:temple-of-sethraliss:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/bfa/templeofsethraliss.jpg"},"midnight-s2:the-blinding-vale":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/vale/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:the-blinding-vale:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/midnight/the_blinding_vale.jpg"},"midnight-s2:voidscar-arena":{"type":"tiles","urlTemplate":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/maps/void/{x}_{y}.jpg","tileSize":64,"origin":[0,0],"flipY":true},"midnight-s2:voidscar-arena:artwork":{"type":"image","url":"https://wcl-mythic-dungeon.oss-cn-beijing.aliyuncs.com/images/dungeons/midnight/voidscar_arena.jpg"}}}
# 旧 threechest 公开瓦片（legacy-threechest:*，S1 前旧坐标快照用）如需本地查看，
# 可按相同形状在 manifest 里手动补 legacy-threechest:* 条目。
# VITE_DUNGEON_ROUTES=true
# Only enable production/preview routes together with a published dungeon
# registry, approved assets, and release QA. DEV enables local previews automatically.
# 生产/preview 不设置以上变量时，自动使用已提交的 OSS manifest
# （src/dungeon/data/assets/oss.manifest.json，由 pnpm dungeon:generate-oss-manifest
# 从本地镜像校验生成）；显式设置 VITE_DUNGEON_ASSET_PROVIDER=placeholder 可强制占位。
