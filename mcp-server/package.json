{
  "name": "wowanalyzer-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for WoWAnalyzerCN - provides WCL report analysis tools",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node build.mjs && tsx watch src/server.ts",
    "build": "node build.mjs && tsc --noEmit",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lingui/core": "6.0.1",
    "@lingui/macro": "5.9.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.19.18",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
